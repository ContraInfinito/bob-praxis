# Environment and credentials
.env

# Virtual environment
venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Output files
output.txt

# Generated output folders from Praxis runs
**/praxis_output/

# Generated .bob/ folders from Praxis runs under tests/ and demo/
# (the project's own top-level .bob/ stays tracked — leading slash anchors
# the pattern to the repo root, so /.bob/ is not matched.)
/tests/**/.bob/
/demo/**/.bob/

# Bob session screenshots (keep markdown exports, ignore images)
bob_sessions/*.png
bob_sessions/*.jpg
bob_sessions/*.jpeg
bob_sessions/*.gif

# Verification capture files
*_output.txt
*_smoke*.txt

# Scratch prompt drafts (kept out of accidental commits)
_claude_code_prompt_*.md
_verify_*.py
_commitmsg.txt
_temp_*.json
